uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel_step;
uniform float4 source_rect;
uniform float center_weight;
uniform float2 pair_weights;
uniform float2 pair_offsets;

sampler_state linear_clamp {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertInOut VSDefault(VertInOut input)
{
	VertInOut output;
	output.pos = mul(float4(input.pos.xyz, 1.0), ViewProj);
	output.uv = input.uv;
	return output;
}

float4 PSBlur(VertInOut input) : TARGET
{
	float2 uv = source_rect.xy + input.uv * source_rect.zw;
	float2 step = texel_step * source_rect.zw;
	float4 color = image.Sample(linear_clamp, uv) * center_weight;
	color += image.Sample(linear_clamp, uv + step * pair_offsets.x) * pair_weights.x;
	color += image.Sample(linear_clamp, uv - step * pair_offsets.x) * pair_weights.x;
	color += image.Sample(linear_clamp, uv + step * pair_offsets.y) * pair_weights.y;
	color += image.Sample(linear_clamp, uv - step * pair_offsets.y) * pair_weights.y;
	return color;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(input);
		pixel_shader = PSBlur(input);
	}
}
